class Solution:
    def leaders(self, arr):
        n = len(arr)
        leaders = []
        
        # Start from the rightmost element
        max_right = arr[-1]
        leaders.append(max_right)
        
        # Traverse from right to left
        for i in range(n - 2, -1, -1):
            if arr[i] >= max_right:
                max_right = arr[i]
                leaders.append(arr[i])
        
        # Reverse to maintain original order
        return leaders[::-1]