class Node:
    """Represents a single node in the Binary Search Tree."""
    def __init__(self, key):
        self.left = None
        self.right = None
        self.val = key

def insert(root, key):
    """Helper function to insert a new node with the given key into the BST."""
    if root is None:
        return Node(key)
    else:
        if root.val < key:
            root.right = insert(root.right, key)
        else:
            root.left = insert(root.left, key)
    return root

# 1. Calculate Total Number of Nodes
def count_nodes(root):
    """Returns the total number of nodes in the BST."""
    if root is None:
        return 0
    # Total nodes = 1 (current node) + nodes in left subtree + nodes in right subtree
    return 1 + count_nodes(root.left) + count_nodes(root.right)

# 2. Find the Minimum Value
def find_min(root):
    """Returns the minimum value in the BST."""
    if root is None:
        return None
    
    current = root
    # Loop down to find the leftmost leaf
    while current.left is not None:
        current = current.left
    return current.val

# 3. Find the Maximum Value
def find_max(root):
    """Returns the maximum value in the BST."""
    if root is None:
        return None
    
    current = root
    # Loop down to find the rightmost leaf
    while current.right is not None:
        current = current.right
    return current.val


# --- Example Usage ---
if __name__ == "__main__":
    # Let's build a simple BST
    #         50
    #       /    \
    #     30      70
    #    /  \    /  \
    #   20  40  60  80
    
    root = Node(50)
    root = insert(root, 30)
    root = insert(root, 70)
    root = insert(root, 20)
    root = insert(root, 40)
    root = insert(root, 60)
    root = insert(root, 80)

    # Running our functions
    total_nodes = count_nodes(root)
    min_value = find_min(root)
    max_value = find_max(root)

    print(f"Total number of nodes: {total_nodes}")
    print(f"Minimum value in BST:  {min_value}")
    print(f"Maximum value in BST:  {max_value}")
